{
  "name": "arcteus",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"npm --prefix apps/backend run dev\" \"npm --prefix apps/frontend run dev\"",
    "start": "npm --prefix apps/backend run start",
    "build": "npm --prefix apps/frontend run build",
    "prestart": "npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "lru-cache": "^11.5.3"
  }
}
